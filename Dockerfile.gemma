FROM python:3.12-slim
RUN useradd --create-home --uid 10001 bottleneck-iq
WORKDIR /app
COPY pyproject.toml README.md ./
COPY backend backend
COPY services services
RUN pip install --no-cache-dir .
RUN mkdir -p /app/data && chown -R bottleneck-iq:bottleneck-iq /app/data
USER bottleneck-iq
ENV PORT=8080 PRODUCTION_EXECUTION=false
CMD ["sh","-c","uvicorn services.gemma.main:app --host 0.0.0.0 --port ${PORT}"]
